DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-production-secret
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Optional Amazon SES email settings. Credentials are loaded from the standard
# AWS credential chain (for example, an IAM role or AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY).
AWS_REGION=us-east-1
SES_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional contact form recipient
CONTACT_EMAIL=
